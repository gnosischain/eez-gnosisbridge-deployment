# Chiado (foreign, chain 10200) <-> RollupX testnet (home, chain 699169)
# Copy to .env.chiado-rollupx-testnet, fill in the two private keys, then:
#   docker compose --env-file .env.chiado-rollupx-testnet up -d

COMPOSE_PROJECT_NAME=chiado-rollupx-testnet
ORACLE_IMAGE=gnosischain/tokenbridge-oracle:v3.12.0
LOG_LEVEL=info

# --- RPC (several URLs can be given, separated by spaces) -------------------
# Home = RollupX testnet
HOME_RPC_URL=https://eez.dev/composer/l2
# Foreign = Chiado
FOREIGN_RPC_URL=https://rpc.chiadochain.net
# Poll roughly once per block: RollupX testnet ~1 s, Chiado 5 s.
HOME_RPC_POLLING_INTERVAL=2000
FOREIGN_RPC_POLLING_INTERVAL=5000

# --- Contracts (deployments/chiado-rollupx-testnet) --------------------------
AMB_HOME_BRIDGE_ADDRESS=0x7423c8479fE83043b07685977c8dd85632B50fC0
AMB_FOREIGN_BRIDGE_ADDRESS=0xD973e95e7a1984FDEFBF7c6Cc32E967e6aD79Ac1
XDAI_HOME_BRIDGE_ADDRESS=0xF1E85f146b1EAfEeE0ed6F7e29dD1599286542ED
XDAI_FOREIGN_BRIDGE_ADDRESS=0x7C7B3770744Fe56E860F2846b22c75A749CD5E79

# --- Validator ---------------------------------------------------------------
# The deployed validator on both bridges is 0xC18516Ce413cB899bC3f8bBA4c204bF97BE990E6.
# It needs xDAI on Chiado and native coin on RollupX testnet to pay for its transactions.
# The oracle documentation asks for a different key per bridge stack, because each
# stack keeps its own nonce counter. With the same key in both stacks, expect
# occasional nonce errors (the sender then re-reads the nonce from the chain).
# Private keys: hexadecimal WITHOUT the 0x prefix. Never commit the filled-in file.
AMB_VALIDATOR_ADDRESS=0xC18516Ce413cB899bC3f8bBA4c204bF97BE990E6
AMB_VALIDATOR_PRIVATE_KEY=
XDAI_VALIDATOR_ADDRESS=0xC18516Ce413cB899bC3f8bBA4c204bF97BE990E6
XDAI_VALIDATOR_PRIVATE_KEY=

# --- Finality ------------------------------------------------------------------
# block-finality: act on the "finalized" block. fcr: act on the "safe" block
# (only if the RPC serves a safe block less than 32 blocks behind the head;
# also start the checkers with --profile fcr).
# RollupX testnet finalizes about 4-5 minutes behind the head.
HOME_BLOCK_PROCESSING_MODE=block-finality
FOREIGN_BLOCK_PROCESSING_MODE=block-finality
# Beacon API URLs (comma-separated). Leave empty: the finalized block is then
# read from the RPC above. RollupX has no beacon API.
HOME_BEACON_URL=
FOREIGN_BEACON_URL=

# --- Gas -------------------------------------------------------------------------
# Used only when fee estimation and the bridge contract's own gas price both fail (wei).
HOME_GAS_PRICE_FALLBACK=1000000000
FOREIGN_GAS_PRICE_FALLBACK=3000000000
